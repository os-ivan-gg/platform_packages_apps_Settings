<?xml version="1.0" encoding="utf-8"?>

<com.google.android.setupdesign.GlifLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/glif_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:icon="@drawable/ic_lock"
>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        style="@style/SudContentFrame">

        <RadioGroup
            android:id="@+id/credential_type"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:checkedButton="@+id/type_pin">

            <RadioButton
                android:id="@id/type_pin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/reboot_cred_type_pin" />

            <RadioButton
                android:id="@+id/type_password"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:text="@string/reboot_cred_type_password" />
        </RadioGroup>

        <EditText
            android:id="@+id/credential_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/reboot_cred_enter_pin"
            android:imeOptions="actionNext"
            android:inputType="numberPassword" />

        <EditText
            android:id="@+id/credential_input_confirmation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/reboot_cred_confirm_pin"
            android:imeOptions="actionDone"
            android:inputType="numberPassword" />

        <TextView
            android:id="@+id/second_factor_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
            android:text="@string/reboot_cred_second_factor_title"
            android:visibility="gone" />

        <EditText
            android:id="@+id/second_factor_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/reboot_cred_second_factor_hint"
            android:imeOptions="actionDone"
            android:inputType="numberPassword"
            android:visibility="gone" />

    </LinearLayout>
</com.google.android.setupdesign.GlifLayout>
